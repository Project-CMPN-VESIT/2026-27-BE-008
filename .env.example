# AWS S3 Configuration (Document Scrapper)
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
AWS_DEFAULT_REGION="ap-southeast-2"
S3_BUCKET="finpilot-doc-scrapper"
S3_PREFIX=doc-scrapper

# LLM Providers
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_API_KEY_1=your_mistral_api_key_1
MISTRAL_API_KEY_2=your_mistral_api_key_2
MISTRAL_API_KEY_3=your_mistral_api_key_3
CYRO_MODEL=ministral-8b-latest

# Internal Services
INDIA_TRADE_CLI_URL=http://127.0.0.1:8765

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/finpilot
