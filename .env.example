# FinPilot environment template.
# Copy this file to `.env` in the repository root and fill in your own values.
# Never commit real keys. Every service reads this one file.

# ── Firebase Authentication (web app) ───────────────────────────────────────
# Firebase console > Project settings > General > your web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (servers only, never prefix with NEXT_PUBLIC_) ───────────
# Firebase console > Project settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# keep the quotes and the \n escapes exactly as in the downloaded JSON
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── PostgreSQL (users, preferences, CYRO chats, paper trading) ──────────────
# Any PostgreSQL works; a managed one (Neon, Supabase, RDS) is the easiest.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Leave empty to reuse DATABASE_URL
CYRO_CHAT_DATABASE_URL=

# ── LLM (Mistral) ───────────────────────────────────────────────────────────
# One key is enough. Extra keys are rotated automatically when one is rate limited.
MISTRAL_API_KEY=
MISTRAL_API_KEY_1=
MISTRAL_API_KEY_2=
MISTRAL_API_KEY_3=
CYRO_AGENTIC_V2_ENABLED=true

# ── Service addresses (defaults shown) ──────────────────────────────────────
INDIA_TRADE_CLI_URL=http://127.0.0.1:8765
VIDEO_ENGINE_URL=http://127.0.0.1:8500
# NEXT_PUBLIC_SCREENER_API_URL=http://localhost:8003

# ── Admin console (change these before any shared or public deployment) ─────
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me
# ADMIN_SESSION_SECRET=any-long-random-string

# ── Optional: filings / document RAG (AWS S3) ───────────────────────────────
# Without these, company document panels simply show "temporarily unavailable".
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
S3_BUCKET=
S3_PREFIX=doc-scrapper

# ── Optional: Nifty Shorts imagery ──────────────────────────────────────────
# UNSPLASH_ACCESS_KEY=
