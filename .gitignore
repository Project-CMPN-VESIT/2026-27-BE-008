# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# doc_scrapper runtime artifacts
doc_Scrapper/**/__pycache__/
doc_Scrapper/**/*.pyc
doc_Scrapper/logs/
doc_Scrapper/output/
doc_Scrapper/annual_reports/
doc_Scrapper/.env

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.benchmarks/

# Python Virtual Environments
venve/
venv/
.venv/
env/
ENV/

# Logs
*.log
logs/
scrapper/logs/
data-pipeline/logs/

# Local databases and runtime caches (preserve tracked core databases)
cyro_security_master.db
/chroma_db/
opt-expiry.json
pipeline_data.db
src/data/nifty_shorts_cache.json

# Video files & generated video renders
*.mp4
*.webm
*.mov
*.avi
*.mkv
public/videos/
video-engine/frontend/public/videos/
video-engine/backend/output/
videos/

# Ephemeral generated TTS audio & scene images (preserve static audio like background-music.mp3)
public/audio/*/
public/images/nifty-shorts/
video-engine/frontend/public/audio/*/
video-engine/frontend/public/audio/test_*
video-engine/frontend/public/audio/scene_*.mp3
video-engine/frontend/public/images/nifty-shorts/

# AI models & ONNX binary weights
video-engine/backend/models/
*.onnx
*.bin

# Video engine dependencies & environments
video-engine/**/node_modules/
video-engine/**/venv/
video-engine/**/.venv/
video-engine/**/__pycache__/

# Archives
*.zip
*.tar.gz
*.rar

# Claude / Editor artifacts
.claude/

