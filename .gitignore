# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# doc_scrapper runtime artifacts
doc_Scrapper/**/__pycache__/
doc_Scrapper/**/*.pyc
doc_Scrapper/logs/
doc_Scrapper/output/
doc_Scrapper/annual_reports/
doc_Scrapper/.env

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.benchmarks/

# Python Virtual Environments
venve/
venv/
.venv/
env/
ENV/

# Logs
*.log
logs/
scrapper/logs/
data-pipeline/logs/

# Local databases and runtime caches (preserve tracked core databases)
cyro_security_master.db
/chroma_db/
opt-expiry.json
pipeline_data.db

# Claude / Editor artifacts
.claude/
