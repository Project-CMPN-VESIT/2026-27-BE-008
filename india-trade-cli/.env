# AWS S3 Configuration
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
AWS_DEFAULT_REGION="ap-southeast-2"
S3_BUCKET="finpilot-doc-scrapper"
S3_PREFIX=doc-scrapper

# LLM Providers
MISTRAL_API_KEY=your_mistral_api_key_here
AI_PROVIDER=openai
OPENAI_BASE_URL=https://api.mistral.ai/v1
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=ministral-8b-latest
CYRO_NORMAL_MODEL=ministral-8b-latest
CYRO_REASONING_MODEL=ministral-8b-latest

# Brokers
FYERS_APP_ID=your_fyers_app_id
FYERS_SECRET_KEY=your_fyers_secret_key
FYERS_REDIRECT_URL=http://127.0.0.1:8765/fyers/callback
NEWSAPI_KEY=your_newsapi_key_here

# Upstox data-ingestion database (read-only, populated by finpilot-data-ingestion project)
EQUITY_DB_PATH=./data/equity.db

# Upstox API access token (for live quote fallback and future re-ingestion runs)
UPSTOX_ACCESS_TOKEN=your_upstox_access_token_here